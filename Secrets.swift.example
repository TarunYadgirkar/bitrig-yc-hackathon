// Secrets.swift.example
//
// Copy this file to `Secrets.swift` and fill in your Anthropic API key:
//
//     cp Secrets.swift.example Secrets.swift
//
// `Secrets.swift` is gitignored, so your real key is never committed.
// Get a key at https://console.anthropic.com → API Keys.
enum Secrets {
    static let anthropicAPIKey = "YOUR_CLAUDE_API_KEY"
}
